<?xml version="1.0" encoding="utf-8"?>
<!-- 自适应图标（Android 8.0+）：系统会把下面三层拼起来，并按各厂商自己的形状裁切
     （圆形 / 方形 / 泪滴形…）。所以前景与单色两层的图形必须落在中心安全区内 ——
     tool/gen_icons.dart 里 160 逻辑单位的设计稿天然满足（图形占约 60%，安全区是 61%）。

     位图由 tool/gen_icons.dart 生成，都放在 drawable-<密度>/ 下；
     背景层是渐变，见 drawable/ic_launcher_background.xml。 -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <!-- 单色层供 Android 13+ 的「主题图标」使用：系统会忽略其中颜色、只取形状并统一染色，
         背景也由系统自备。所以这一层直接取整个图形（一道缺口环 + 偏心点）的实心轮廓，
         颜色统一交给系统；具体参数见 tool/gen_icons.dart 的 kRingR / kRingW / kGapFrom。 -->
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
